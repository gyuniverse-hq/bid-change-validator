# Supabase Session pooler URI. 비밀번호의 특수문자는 URL 인코딩합니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:replace_with_database_password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

G2B_SERVICE_KEY=replace_with_your_service_key
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-5.6-luna

# S3를 아직 정하지 않았다면 LOCAL로 바꿀 수 있지만, 해당 서버 볼륨에만 보존됩니다.
DOCUMENT_STORAGE_BACKEND=S3
DOCUMENT_S3_BUCKET=replace_with_bucket_name
DOCUMENT_S3_PREFIX=notice-documents
AWS_REGION=ap-northeast-2

CORS_ORIGINS=https://replace-with-frontend-domain.example
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
# 운영환경에서는 12자 이상이며 admin이 아닌 값만 허용됩니다.
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_random_password
AUTH_SESSION_TTL_HOURS=12

NOTICE_POLL_INTERVAL_SECONDS=300
NOTICE_POLL_LOOKBACK_MINUTES=60
NOTICE_POLL_OVERLAP_MINUTES=5
NOTICE_POLL_PAGE_SIZE=100
NOTICE_POLL_MAX_PAGES=10
NOTICE_POLL_BUSINESS_TYPES=SERVICE,GOODS,CONSTRUCTION,FOREIGN
